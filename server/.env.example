# ============================================================
# 复制为 .env 后按需修改。所有值都会被 src/config/index.ts 校验。
# ============================================================

# ---------- 运行环境 ----------
# development => HTTP + 非 Secure Cookie
# production  => 必须 HTTPS，Cookie 自动加 Secure 标记
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# 前端（SPA）地址，用于 CORS 与第三方登录完成后的回跳
APP_ORIGIN=http://localhost:5173
# 后端对外地址，用于拼接第三方登录的 redirect_uri
PUBLIC_BASE_URL=http://localhost:3000
# 允许的来源，逗号分隔（4173 是 vite preview 的端口）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# ---------- MySQL ----------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=summer_camp
MYSQL_POOL_SIZE=10

# ---------- JWT ----------
# 至少 32 个字符；生产环境请使用 `openssl rand -base64 48` 生成
JWT_SECRET=dev-only-secret-please-change-me-32chars!!
JWT_ISSUER=summer-camp
JWT_AUDIENCE=summer-camp-web
JWT_ACCESS_TTL_SECONDS=900
JWT_CLOCK_TOLERANCE_SECONDS=30

# ---------- Cookie ----------
ACCESS_COOKIE_NAME=sc_at
REFRESH_COOKIE_NAME=sc_rt
CSRF_COOKIE_NAME=sc_csrf
REFRESH_TTL_SECONDS=604800
# 留空表示不设置 Domain（宿主机级别），跨子域共享时再填
# COOKIE_DOMAIN=

# ---------- 密码 / OTP ----------
PASSWORD_HASH_ROUNDS=12
# 至少 16 个字符，用于对 OTP 做 HMAC，避免明文落库
OTP_SECRET=dev-only-otp-secret-change-me
# 题目要求：邮箱验证码有效期为 1 小时（3600 秒）
OTP_TTL_SECONDS=3600
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# ---------- 邮件 ----------
# 下面是利用qq smtp service的例子
# MAIL_FROM="Summer Camp <xxxxxx@qq.com>"
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=xxxx@qq.com
# SMTP_PASSWORD=
MAIL_FROM="Summer Camp <no-reply@localhost>"
# 不配置 SMTP_HOST 时，开发环境会把 OTP 直接打印到日志里，便于本地调试
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=

# ---------- 第三方登录：GitHub (OAuth2) ----------
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3000/user/oauth/github/callback

# ---------- 第三方登录：通用 OIDC ----------
# OIDC_ISSUER=https://accounts.google.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/user/oauth/oidc/callback
OIDC_SCOPES=openid profile email

# ---------- 安全开关 ----------
# 对非安全方法（POST/PUT/PATCH/DELETE）校验 Origin 头
AUTH_ENFORCE_TRUSTED_ORIGIN=true

# ---------- 预置账号（bootstrap）----------
# 启动时幂等创建 1 个 admin + 2 个 supervisor，邮箱直接标记为已验证，可直接登录。
# 注意 - 在填写申请表的时候必须要选择预设的两个supervisor,否则application form的流程不能完成
# 全部留空则不创建任何账号。EMAIL 与 PASSWORD 必须成对配置，否则启动报错。
# 密码至少 16 位；已有账号不会被覆盖密码。
BOOTSTRAP_ON_START=true
# 已存在账号角色不一致时是否强制纠正（默认只告警不修改）
BOOTSTRAP_ENFORCE_ROLE=false

BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=1234567890123456
# Docker secret / k8s Secret 支持：填文件路径，优先于上面的明文密码。
# 本地开发没有 /run/secrets 目录，请保持下面这些 *_FILE 变量注释状态。
# BOOTSTRAP_ADMIN_PASSWORD_FILE=/run/secrets/bootstrap_admin_password

BOOTSTRAP_SUPERVISOR_1_EMAIL=supervisor002@example.com
BOOTSTRAP_SUPERVISOR_1_PASSWORD=1234567890123456
# 本地开发没有 /run/secrets 目录，请保持下面这些 *_FILE 变量注释状态。
# BOOTSTRAP_SUPERVISOR_1_PASSWORD_FILE=/run/secrets/bootstrap_supervisor_1_password

BOOTSTRAP_SUPERVISOR_2_EMAIL=supervisor032@example.com
BOOTSTRAP_SUPERVISOR_2_PASSWORD=1234567890123456
# 本地开发没有 /run/secrets 目录，请保持下面这些 *_FILE 变量注释状态。
# BOOTSTRAP_SUPERVISOR_2_PASSWORD_FILE=/run/secrets/bootstrap_supervisor_2_password
